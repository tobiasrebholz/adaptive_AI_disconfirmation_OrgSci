cript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_3UiALttLFjU6WoK","Element":"SQ","PrimaryAttribute":"QID37","SecondaryAttribute":"What other tools with generative AI (apart from chatbots) have you already used? Please list each...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>What other tools with generative AI (apart from chatbots) have you already used?<\/strong><br \/>\n<em>Please list each tool in a separate text box. Additional boxes will appear as you type.&nbsp;If you have not used any, you may leave the field(s) blank.<\/em><\/p>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n  const questionContainer = document.getElementById(this.questionId);\n  const textInputs = Array.from(questionContainer.querySelectorAll('input[type=\"text\"]'));\n  \/\/console.log(textInputs);\n\n  \/\/ Initially hide all except the first input\n  for (let i = 1; i < textInputs.length; i++) {\n    const row = textInputs[i].closest(\"tr\");\n    if (row) row.style.display = \"none\";\n  }\n\n  \/\/ Add input event listeners to each field\n  textInputs.forEach((input, index) => {\n    input.addEventListener('input', () => {\n      const nextIndex = index + 1;\n      if (input.value.trim() !== '' && nextIndex < textInputs.length) {\n        const nextRow = textInputs[nextIndex].closest(\"tr\");\n        if (nextRow && nextRow.style.display === \"none\") {\n          nextRow.style.display = \"\";\n        }\n      }\n    });\n  });\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"listOtherGenAI","QuestionType":"TE","Selector":"FORM","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What other tools 