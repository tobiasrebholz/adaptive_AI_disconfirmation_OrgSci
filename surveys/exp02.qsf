dth = \"min(90vw, 600px)\";\n\t  infoMdlContent.style.maxHeight = \"80vh\";     \/\/ keep within viewport height\n\t  infoMdlContent.style.overflowY = \"auto\";     \/\/ <-- makes content scrollable\n\t  infoMdlContent.style.textAlign = \"left\";\n\n\t  \/\/ Inner HTML (scenario + close button)\n\t  infoMdlContent.innerHTML = `<div>\n\t`\n\t+\n\tscenarioDesc\n\t+\n\t`<\/div>\n\t\t<button id=\"closeModalBtn\"\n\t\t  type=\"button\"\n\t\t  style=\"display:block;margin:15px auto 0;padding:8px 16px;background-color:#1A2354;color:#fff;border:none;border-radius:4px;cursor:pointer;\">\n\t\t  Close\n\t\t<\/button>\n\t  `;\n\n\t  \/\/ Assemble modal\n\t  infoMdl.appendChild(infoMdlContent);\n\n\t  \/\/ ----- Open \/ close helpers -----\n\t  let prevFocus = null;\n\n\t  const escHandler = (e) => {\n\t\tif (e.key === \"Escape\") closeModal();\n\t  };\n\n\t  function openModal() {\n\t\tprevFocus = document.activeElement;\n\t\tinfoMdl.style.display = \"flex\";\n\t\tdocument.body.style.overflow = \"hidden\"; \/\/ lock background scroll\n\t\tdocument.addEventListener(\"keydown\", escHandler);\n\t\tconst closeBtn = infoMdlContent.querySelector(\"#closeModalBtn\");\n\t\tif (closeBtn) closeBtn.focus();\n\t  }\n\n\t  function closeModal() {\n\t\tinfoMdl.style.display = \"none\";\n\t\tdocument.body.style.overflow = \"\"; \/\/ restore background scroll\n\t\tdocument.removeEventListener(\"keydown\", escHandler);\n\t\tif (prevFocus && typeof prevFocus.focus === \"function\") {\n\t\t  prevFocus.focus();\n\t\t}\n\t  }\n\n\t  \/\/ ----- Wire up events -----\n\t  infoBtn.addEventListener(\"click\", openModal);\n\n\t  \/\/ Close via button\n\t  infoMdlContent.querySelector(\"#closeModalBtn\").addEventListener(\"click\", closeModal);\n\n\t  \/\/ Close when clicking outside the content\n\t  infoMdl.addEventListener(\"click\", (e) => {\n\t\tif (e.target === infoMdl) closeModal();\n\t  });\n\n\t  \/\/ ----- Add elements to the page -----\n\t  this.getQuestionContainer().appendChild(infoBtn); \/\/ next to any other buttons you add\n\t  document.body.appendChild(infoMdl);\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n  \t\/\/ Runs when the page is fully displayed\n});\n\nQualtrics.SurveyEngine.addOnUnload(function () {\n  \t\/\/ Cleanup is handled automatically when the page unloads in Qualtrics\n});"}},{"SurveyID":"SV_54MgdZcW28rPICG","Element":"SQ","PrimaryAttribute":"QID83","SecondaryAttribute":"There are essentially two possible strategies that can be used to determine the optimal ranking o...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><b>There are essentially two possible strategies that can be used to determine the optimal ranking of items in terms of their importance for survival:<\/b><\/p>\n<ul>\n\t<li>${e:\/\/Field\/whichStrategyDetailed_1}<\/li>\n<\/ul>\n<ul>\n\t<li>${e:\/\/Field\/whichStrategyDetailed_2}<\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"instr_stratChoice","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"There are essentially two possible strategies that can be used to determine the optimal ranking o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID83","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/\/ Capture the HTML content of the current question text container\n\tvar questionText = this.getQuestionTextContainer().innerHTML;\n\t\/\/console.log(questionText);\n\t\n\t\/\/ Store it in an embedded data field\n    Qualtrics.SurveyEngine.setEmbeddedData(\"scenarioDesc3\", questionText);\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_54MgdZcW28rPICG","Element