"},"5":{"Display":"<i>Prefer not to say<\/i>"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataVisibility":{"Hidden":false,"Private":false},"GradingData":[],"Language":{"DE":{"QuestionText":"Wie beschreiben Sie sich selbst?","Choices":{"1":{"Display":"M\u00e4nnlich"},"2":{"Display":"Weiblich"},"3":{"Display":"Nichtbin\u00e4r\/drittes Geschlecht"},"4":{"Display":"Selbstbeschreibung bevorzugt"},"5":{"Display":"Keine Angabe"}}},"EN-GB":{"QuestionText":"How do you describe yourself?","Choices":{"1":{"Display":"Male"},"2":{"Display":"Female"},"3":{"Display":"Non-binary \/ third gender"},"4":{"Display":"Prefer to self-describe"},"5":{"Display":"Prefer not to say"}}},"ES":{"QuestionText":"\u00bfC\u00f3mo se describe a usted mismo?","Choices":{"1":{"Display":"Masculino"},"2":{"Display":"Femenino"},"3":{"Display":"No binario \/ tercer sexo"},"4":{"Display":"Preferencia de autodescripci\u00f3n"},"5":{"Display":"Preferencia de no especificar"}}},"ES-ES":{"QuestionText":"\u00bfC\u00f3mo se describe a s\u00ed mismo?","Choices":{"1":{"Display":"Masculino"},"2":{"Display":"Femenino"},"3":{"Display":"No binario \/ tercer g\u00e9nero"},"4":{"Display":"Prefiere autodescribirse"},"5":{"Display":"Prefiero no decirlo"}}},"FR":{"QuestionText":"Comment vous d\u00e9crivez-vous\u00a0?","Choices":{"1":{"Display":"Un homme"},"2":{"Display":"Une femme"},"3":{"Display":"Non-binaire\/transgenre"},"4":{"Display":"Pr\u00e9f\u00e8re se d\u00e9crire soi-m\u00eame"},"5":{"Display":"Ne souhaite pas r\u00e9pondre"}}},"IT":{"QuestionText":"Come descrivi te stesso\/a?","Choices":{"1":{"Display":"Maschio"},"2":{"Display":"Femmina"},"3":{"Display":"Genere non-binario\/Terzo genere"},"4":{"Display":"Preferisco descrivermi personalmente"},"5":{"Display":"Preferisco non dirlo"}}},"JA":{"QuestionText":"\u81ea\u8eab\u306e\u6027\u8a8d\u8b58","Choices":{"1":{"Display":"\u7537\u6027"},"2":{"Display":"\u5973\u6027"},"3":{"Display":"\u30ce\u30f3\u30d0\u30a4\u30ca\u30ea\u30fc\uff0f\u7b2c\u4e09\u306e\u60