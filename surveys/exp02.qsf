eOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID139","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t  \/\/ Keep references handy\n\t  var qid = this.questionId;\n\t  var that = this;\n\n\t  \/\/ Pull the embedded data (allowing HTML if present)\n\t  var scenarioDesc = Qualtrics.SurveyEngine.getEmbeddedData(\"scenarioDesc\") || \"\";\n\n\t  \/\/ ----- Create the \"Show Scenario Description\" button -----\n\t  const infoBtn = document.createElement(\"button\");\n\t  infoBtn.type = \"button\";\n\t  infoBtn.textContent = \"Show Scenario Description\";\n\t  infoBtn.style.backgroundColor = \"#988675\";\n\t  infoBtn.style.color = \"white\";\n\t  infoBtn.style.border = \"none\";\n\t  infoBtn.style.padding = \"12px 24px\";\n\t  infoBtn.style.fontSize = \"16px\";\n\t  infoBtn.style.borderRadius = \"6px\";\n\t  infoBtn.style.cursor = \"pointer\";\n\t  infoBtn.style.display = \"block\";\n\t  infoBtn.style.margin = \"5px auto\";\n\t  infoBtn.style.textAlign = \"center\";\n\n\t  \/\/ ----- Create the overlay (modal container) -----\n\t  const infoMdl = document.createElement(\"div\");\n\t  infoMdl.setAttribute(\"role\", \"dialog\");\n\t  infoMdl.setAttribute(\"aria-modal\", \"true\");\n\t  infoMdl.style.display = \"none\";              \/\/ hidden by default\n\t  infoMdl.style.position = \"fixed\";\n\t  infoMdl.style.zIndex = \"10000\";\n\t  infoMdl.style.left = \"0\";\n\t  infoMdl.style.top = \"0\";\n\t  infoMdl.style.width = \"100%\";\n\t  infoMdl.style.height = \"100%\";\n\t  infoMdl.style.backgroundColor = \"rgba(0,0,0,0.5)\";\n\t  infoMdl.style.justifyContent = \"center\";\n\t  infoMdl.style.alignItems = \"center\";\n\t  infoMdl.style.padding = \"24px\";              \/\/ breathing room on small screens\n\n\t  \/\/ Optional: allow the overlay itself to scroll if content overflows its padding area\n\t  infoMdl.style.overflowY = \"auto\";\n\n\t  \/\/ ----- Create the modal content -----\n\t  const infoMdlContent = document.createElement(\"div\");\n\t  infoMdlContent.style.backgroundColor = \"#fff\";\n\t  infoMdlContent.style.padding = \"20px\";\n\t  \/\/infoMdlContent.style.borderRadius = \"10px\";\n\t  infoMdlContent.style.boxShadow = \"0 5px 15px rgba(0,0,0,0.3)\";\n\t  infoMdlContent.style.width = \"min(90vw, 600px)\";\n\t  infoMdlContent.style.maxHeight = \"80vh\";     \/\/ keep within viewport height\n\t  infoMdlContent.style.overflowY = \"auto\";     \/\/ <-- makes content scrollable\n\t  infoMdlContent.style.textAlign = \"left\";\n\n\t  \/\/ Inner HTML (scenario + close button)\n\t  infoMdlContent.innerHTML = `<div>\n\t`\n\t+\n\tscenarioDesc\n\t+\n\t`<\/div>\n\t\t<button id=\"closeModalBtn\"\n\t\t  type=\"button\"\n\t\t  style=\"display:block;margin:15px auto 0;padding:8px 16px;background-color:#1A2354;color:#fff;border:none;border-radius:4px;cursor:pointer;\">\n\t\t  Close\n\t\t<\/button>\n\t  `;\n\n\t  \/\/ Assemble modal\n\t  infoMdl.appendChild(infoMdlContent);\n\n\t  \/\/ ----- Open \/ close helpers -----\n\t  let prevFocus = null;\n\n\t  const escHandler = (e) => {\n\t\tif (e.key === \"Escape\") closeModal();\n\t  };\n\n\t  function openModal() {\n\t\tprevFocus = document.activeElement;\n\t\tinfoMdl.style.display = \"flex\";\n\t\tdocument.body.style.overflow = \"hidden\"; \/\/ lock background scroll\n\t\tdocument.addEventListener(\"keydown\", escHandler);\n\t\tconst closeBtn = infoMdlContent.querySelector(\"#closeModalBtn\");\n\t\tif (closeBtn) closeBtn.focus();\n\t  }\n\n\t  function closeModal() {\n\t\tinfoMdl.style.display = \"none\";\n\t\tdocument.body.style.overflow = \"\"; \/\/ restore background scroll\n\t\tdocument.removeEventListener(\"keydown\", escHandler);\n\t\tif (prevFocus && typeof prevFocus.focus === \"function\") {\n\t\t  prevFocus.focus();\n\t\t}\n\t  }\n\n\t  \/\/ ----- Wire up events -----\n\t  infoBtn.addEventListener(\"click\", openModal);\n\n\t  \/\/ Close via button\n\t  infoMdlContent.querySelector(\"#closeModalBtn\").addEventListener(\"click\", closeModal);\n\n\t  \/\/ Close when clicking outside the content\n\t  infoMdl.addEventListener(\"click\", (e) => {\n\t\tif (e.target === infoMdl) closeModal();\n\t  });\n\n\t  \/\/ ----- Add elements to the page -----\n\t  this.getQuestionContainer().appendChild(infoBtn); \/\/ next to any other buttons you add\n\t  document.body.appendChild(infoMdl);\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_54MgdZcW28rPICG","Element":"SQ","PrimaryAttribute":"QID140","SecondaryAttribute":"Below is feedback on your responses to the previous questions about the scenario. ...","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Below is feedback on your responses to the previous questions about the scenario.<\/b><br>\n<br>\n<div class=\"scenario-feedback\" data-correct=\"${q:\/\/QID133\/ChoiceDescription\/1}\">\n  <div class=\"q\">${q:\/\/QID133\/QuestionText}<\/div>\n  <div class=\"correct-msg\">\n    Your response was correct:\n    <span class=\"resp\"><u>${q:\/\/QID133\/ChoiceGroup\/SelectedChoices}<\/u><\/span>\n  <\/div>\n  <div class=\"wrong-msg\">\n    Your response was not correct:\n    <span class=\"resp\"><u>${q:\/\/QID133\/ChoiceGroup\/SelectedChoices}<\/u><\/span>\n  <\/div>\n  <div class=\"correct-answer\">\n    The correct answer is:\n    <span class=\"corr\"><u>${q:\/\/QID133\/ChoiceDescription\/1}<\/u><\/span>\n  <\/div>\n<\/div>\n\n<br>\n\n<div class=\"scenario-feedback\" data-correct=\"${q:\/\/QID134\/ChoiceDescription\/1}\">\n  <div class=\"q\">${q:\/\/QID134\/QuestionText}<\/div>\n  <div class=\"correct-msg\">\n    Your response was correct:\n    <span class=\"resp\"><u>${q:\/\/QID134\/ChoiceGroup\/SelectedChoices}<\/u><\/span>\n  <\/div>\n  <div class=\"wrong-msg\">\n    Your response was not correct:\n    <span class=\"resp\"><u>${q:\/\/QID134\/ChoiceGroup\/SelectedChoices}<\/u><\/span>\n  <\/div>\n  <div class=\"correct-answer\">\n    The correct answer is:\n    <span class=\"corr\"><u>${q:\/\/QID134\/ChoiceDescription\/1}<\/u><\/span>\n  <\/div>\n<\/div>\n\n<br>\n\n<div class=\"scenario-feedback\" data-correct=\"${q:\/\/QID135\/ChoiceDescription\/1}\">\n  <div class=\"q\">${q:\/\/QID135\/QuestionText}<\/div>\n  <div class=\"correct-msg\">\n    Your response was correct:\n    <span class=\"resp\"><u>${q:\/\/QID135\/ChoiceGroup\/SelectedChoices}<\/u><\/span>\n  <\/div>\n  <div class=\"wrong-msg\">\n    Your response was not correct:\n    <span class=\"resp\"><u>${q:\/\/QID135\/ChoiceGroup\/SelectedChoices}<\/u><\/span>\n  <\/div>\n  <div class=\"correct-answer\">\n    The correct answer is:\n    <span class=\"corr\"><u>${q:\/\/QID135\/ChoiceDescription\/1}<\/u><\/span>\n  <\/div>\n<\/div>\n\n<br>\n\n<div class=\"scenario-feedback\" data-correct=\"${q:\/\/QID136\/ChoiceDescription\/1}\">\n  <div class=\"q\">${q:\/\/QID136\/QuestionText}<\/div>\n  <div class=\"correct-msg\">\n    Your response was correct:\n    <span class=\"resp\"><u>${q:\/\/QID136\/ChoiceGroup\/SelectedChoices}<\/u><\/span>\n  <\/div>\n  <div class=\"wrong-msg\">\n    Your response was not correct:\n    <span class=\"resp\"><u>${q:\/\/QID136\/ChoiceGroup\/SelectedChoices}<\/u><\/span>\n  <\/div>\n  <div class=\"correct-answer\">\n    The correct answer is:\n    <span class=\"corr\"><u>${q:\/\/QID136\/ChoiceDescription\/1}<\/u><\/span>\n  <\/div>\n<\/div>","DefaultChoices":false,"DataExportTag":"feedback_compCheck","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Below is feedback on your responses to the previous questions about the scenario. ...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID140","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t  \/\/ Color-coding of responses depending on correctness\n\t  document.querySelectorAll(\".scenario-feedback\").forEach(function (block) {\n\t\tvar responseText = block.querySelector(\".resp\").textContent.trim();\n\t\tvar correctText = block.dataset.correct.trim();\n\n\t\tvar correctMsg = block.querySelector(\".correct-msg\");\n\t\tvar wrongMsg = block.querySelector(\".wrong-msg\");\n\t\tvar correctAnswer = block.querySelector(\".correct-answer\");\n\n\t\tif (responseText === correctText) {\n\t\t  correctMsg.style.display = \"block\";\n\t\t  correctMsg.style.color = \"green\";\n\n\t\t  wrongMsg.style.display = \"none\";\n\t\t  correctAnswer.style.display = \"none\";\n\t\t} else {\n\t\t  correctMsg.style.display = \"none\";\n\n\t\t  wrongMsg.style.display = \"block\";\n\t\t  wrongMsg.style.color = \"red\";\n\n\t\t  correctAnswer.style.display = \"block\";\n\t\t  \/\/correctAnswer.style.color = \"green\";\n\t\t}\n\t  });\n\t\n\t\/\/ Calculate payoff\n\tvar compCheck_1 = Qualtrics.SurveyEngine.getEmbeddedData(\"compCheck_1\");\n\tvar compCheck_2 = Qualtrics.SurveyEngine.getEmbeddedData(\"compCheck_2\");\n\tvar compCheck_3 = Qualtrics.SurveyEngine.getEmbeddedData(\"compCheck_3\");\n\tvar compCheck_4 = Qualtrics.SurveyEngine.getEmbeddedData(\"compCheck_4\");\n\t\/\/console.log(\"comprehensionChecks:\", compCheck_1, compCheck_2, compCheck_3, compCheck_4);\n\t\/\/console.log(compCheck_1 === \"1\", compCheck_2 === \"1\", compCheck_3 === \"1\", compCheck_4 === \"1\");\n\tlet payoff_compCheck = (((compCheck_1 === \"1\") + (compCheck_2 === \"1\") + (compCheck_3 === \"1\") + (compCheck_4 === \"1\")) * 5) \/ 100;\n\tQualtrics.SurveyEngine.setEmbeddedData(\"payoff_compCheck\", payoff_compCheck.toFixed(2));\n\t\/\/console.log(payoff_compCheck);\n\t\n\t\/\/ Keep references handy\n\t  var qid = this.questionId;\n\t  var that = this;\n\n\t  \/\/ Pull the embedded data (allowing HTML if present)\n\t  var scenarioDesc = Qualtrics.SurveyEngine.getEmbeddedData(\"scenarioDesc\") || \"\";\n\n\t  \/\/ ----- Create the \"Show Scenario Description\" button -----\n\t  const infoBtn = document.createElement(\"button\");\n\t  infoBtn.type = \"button\";\n\t  infoBtn.textContent = \"Show Scenario Description\";\n\t  infoBtn.style.backgroundColor = \"#988675\";\n\t  infoBtn.style.color = \"white\";\n\t  infoBtn.style.border = \"none\";\n\t  infoBtn.style.padding = \"12px 24px\";\n\t  infoBtn.style.fontSize = \"16px\";\n\t  infoBtn.style.borderRadius = \"6px\";\n\t  infoBtn.style.cursor = \"pointer\";\n\t  infoBtn.style.display = \"block\";\n\t  infoBtn.style.margin = \"5px auto\";\n\t  infoBtn.style.textAlign = \"center\";\n\n\t  \/\/ ----- Create the overlay (modal container) -----\n\t  const infoMdl = document.createElement(\"div\");\n\t  infoMdl.setAttribute(\"role\", \"dialog\");\n\t  infoMdl.setAttribute(\"aria-modal\", \"true\");\n\t  infoMdl.style.display = \"none\";              \/\/ hidden by default\n\t  infoMdl.style.position = \"fixed\";\n\t  infoMdl.style.zIndex = \"10000\";\n\t  infoMdl.style.left = \"0\";\n\t  infoMdl.style.top = \"0\";\n\t  infoMdl.style.width = \"100%\";\n\t  infoMdl.style.height = \"100%\";\n\t  infoMdl.style.backgroundColor = \"rgba(0,0,0,0.5)\";\n\t  infoMdl.style.justifyContent = \"center\";\n\t  infoMdl.style.alignItems = \"center\";\n\t  infoMdl.style.padding = \"24px\";              \/\/ breathing room on small screens\n\n\t  \/\/ Optional: allow the overlay itself to scroll if content overflows its padding area\n\t  infoMdl.style.overflowY = \"auto\";\n\n\t  \/\/ ----- Create the modal content -----\n\t  const infoMdlContent = document.createElement(\"div\");\n\t  infoMdlContent.style.backgroundColor = \"#fff\";\n\t  infoMdlContent.style.padding = \"20px\";\n\t  \/\/infoMdlContent.style.borderRadius = \"10px\";\n\t  infoMdlContent.style.boxShadow = \"0 5px 15px rgba(0,0,0,0.3)\";\n\t  infoMdlContent.style.width = \"min(90vw, 600px)\";\n\t  infoMdlContent.style.maxHeight = \"80vh\";     \/\/ keep within viewport height\n\t  infoMdlContent.style.overflowY = \"auto\";     \/\/ <-- makes content scrollable\n\t  infoMdlContent.style.textAlign = \"left\";\n\n\t  \/\/ Inner HTML (scenario + close button)\n\t  infoMdlContent.innerHTML = `<div>\n\t`\n\t+\n\tscenarioDesc\n\t+\n\t`<\/div>\n\t\t<button id=\"closeModalBtn\"\n\t\t  type=\"button\"\n\t\t  style=\"display:block;margin:15px auto 0;padding:8px 16px;background-color:#1A2354;color:#fff;border:none;border-radius:4px;cursor:pointer;\">\n\t\t  Close\n\t\t<\/button>\n\t  `;\n\n\t  \/\/ Assemble modal\n\t  infoMdl.appendChild(infoMdlContent);\n\n\t  \/\/ ----- Open \/ close helpers -----\n\t  let prevFocus = null;\n\n\t  const escHandler = (e) => {\n\t\tif (e.key === \"Escape\") closeModal();\n\t  };\n\n\t  function openModal() {\n\t\tprevFocus = document.activeElement;\n\t\tinfoMdl.style.display = \"flex\";\n\t\tdocument.body.style.overflow = \"hidden\"; \/\/ lock background scroll\n\t\tdocument.addEventListener(\"keydown\", escHandler);\n\t\tconst closeBtn = infoMdlContent.querySelector(\"#closeModalBtn\");\n\t\tif (closeBtn) closeBtn.focus();\n\t  }\n\n\t  function closeModal() {\n\t\tinfoMdl.style.display = \"none\";\n\t\tdocument.body.style.overflow = \"\"; \/\/ restore background scroll\n\t\tdocument.removeEventListener(\"keydown\", escHandler);\n\t\tif (prevFocus && typeof prevFocus.focus === \"function\") {\n\t\t  prevFocus.focus();\n\t\t}\n\t  }\n\n\t  \/\/ ----- Wire up events -----\n\t  infoBtn.addEventListener(\"click\", openModal);\n\n\t  \/\/ Close via button\n\t  infoMdlContent.querySelector(\"#closeModalBtn\").addEventListener(\"click\", closeModal);\n\n\t  \/\/ Close when clicking outside the content\n\t  infoMdl.addEventListener(\"click\", (e) => {\n\t\tif (e.target === infoMdl) closeModal();\n\t  });\n\n\t  \/\/ ----- Add elements to the page -----\n\t  this.getQuestionContainer().appendChild(infoBtn); \/\/ next to any other buttons you add\n\t  document.body.appendChild(infoMdl);\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_54MgdZcW28rPICG","Element":"SQ","PrimaryAttribute":"QID141","SecondaryAttribute":"${q:\/\/QID85\/ChoiceGroup\/AllChoicesTextEntry} ${q:\/\/QID85\/ChoiceTextEntryValue\/1} ...","TertiaryAttribute":null,"Payload":{"QuestionText":"${q:\/\/QID85\/ChoiceGroup\/AllChoicesTextEntry}<br><br>${q:\/\/QID85\/ChoiceTextEntryValue\/1}<br><br>${q:\/\/QID85\/ChoiceTextEntryValue\/2}<br>\n\n<h3>Hier field:<\/h3>\n${e:\/\/Field\/strategyChoiceReasonsUser_initial}","DefaultChoices":false,"DataExportTag":"Q55","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"${q:\/\/QID85\/ChoiceGroup\/AllChoicesTextEntry} ${q:\/\/QID85\/ChoiceTextEntryValue\/1} ...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID141"}},{"SurveyID":"SV_54MgdZcW28rPICG","Element":"SQ","PrimaryAttribute":"QID28","SecondaryAttribute":"Did you experience any technical problems during your interaction with ${e:\/\/Field\/assistantName}...","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Did you experience any technical problems during your interaction with ${e:\/\/Field\/assistantName} in this test?<\/b><br>\n<i>Technically flawless communication with the AI assistant is of utmost importance to this study. Therefore, if you experienced any technical problems, please report and describe them briefly.<\/i>","DefaultChoices":false,"DataExportTag":"chatbotProblems_test","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hid